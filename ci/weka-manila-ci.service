[Unit]
Description=Weka Manila Third-Party CI - Gerrit Event Listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stack
Group=stack
ExecStart=/usr/bin/python3 /opt/weka-ci/gerrit-listener.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=weka-manila-ci
Environment=HOME=/home/stack
Environment=GERRIT_USER=Assaf
# Load CI_VM_IP (public IP for log URLs), Weka creds, GERRIT_TOKEN, etc. so
# per-comment runs (ci-runner -> post-results) post the reachable public log
# URL instead of falling back to `hostname -I` (the VM's private IP).
EnvironmentFile=/opt/weka-ci/ci-env

[Install]
WantedBy=multi-user.target
